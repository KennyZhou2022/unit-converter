{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KennyZhou2022/unit-converter/main/schemas/unit_catalog.schema.json",
  "title": "nist-unit-converter unit catalog",
  "type": "object",
  "required": [
    "version",
    "source",
    "totals",
    "unit_registry_version",
    "units",
    "categories"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 3
    },
    "source": {
      "type": "object",
      "required": ["name", "document", "appendix", "pages"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "appendix": {
          "type": "string",
          "minLength": 1
        },
        "pages": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "totals": {
      "type": "object",
      "required": [
        "category_count",
        "direct_conversion_count",
        "unit_count",
        "connected_component_count",
        "quantity_count",
        "convertibility_model",
        "unordered_convertible_pair_count",
        "ordered_convertible_pair_count",
        "unit_ui_mapping_count",
        "full_list_ui_mapping_count",
        "nist_context_ui_mapping_count",
        "explicit_override_ui_mapping_count",
        "unmapped_ui_unit_count"
      ],
      "additionalProperties": false,
      "properties": {
        "category_count": {
          "type": "integer",
          "minimum": 0
        },
        "direct_conversion_count": {
          "type": "integer",
          "minimum": 0
        },
        "unit_count": {
          "type": "integer",
          "minimum": 0
        },
        "connected_component_count": {
          "type": "integer",
          "minimum": 0
        },
        "quantity_count": {
          "type": "integer",
          "minimum": 0
        },
        "convertibility_model": {
          "description": "Pair totals are derived from UnitConverter.can_convert().",
          "const": "runtime_graph"
        },
        "unordered_convertible_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "ordered_convertible_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "unit_ui_mapping_count": {
          "type": "integer",
          "minimum": 0
        },
        "full_list_ui_mapping_count": {
          "type": "integer",
          "minimum": 0
        },
        "nist_context_ui_mapping_count": {
          "type": "integer",
          "minimum": 0
        },
        "explicit_override_ui_mapping_count": {
          "type": "integer",
          "minimum": 0
        },
        "unmapped_ui_unit_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unit_registry_version": {
      "type": "integer",
      "const": 1
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unitRecord"
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogGroup"
      }
    }
  },
  "$defs": {
    "unitRecord": {
      "type": "object",
      "required": [
        "unit_id",
        "quantity_id",
        "display_name",
        "aliases",
        "nist_categories",
        "ui_mapping_status",
        "ui_categories"
      ],
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^unit\\.u[0-9]{4,}$"
        },
        "quantity_id": {
          "type": "string",
          "pattern": "^quantity\\.q[0-9]{4,}$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "nist_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["category"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "subcategory": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "ui_mapping_status": {
          "type": "string",
          "enum": ["mapped", "unmapped"]
        },
        "ui_mapping_note": {
          "type": "string",
          "minLength": 1
        },
        "ui_categories": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "subcategory", "match_method"],
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "subcategory": {
                "type": "string",
                "minLength": 1
              },
              "match_method": {
                "type": "string",
                "enum": [
                  "full_list_unit",
                  "nist_context",
                  "explicit_override"
                ]
              },
              "matched_full_list_units": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "catalogGroup": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "unit_count",
        "direct_conversion_count",
        "connected_component_count",
        "unordered_convertible_pair_count",
        "ordered_convertible_pair_count",
        "units",
        "connected_components"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "subcategory": {
          "type": "string",
          "minLength": 1
        },
        "unit_count": {
          "type": "integer",
          "minimum": 0
        },
        "direct_conversion_count": {
          "type": "integer",
          "minimum": 0
        },
        "connected_component_count": {
          "type": "integer",
          "minimum": 0
        },
        "unordered_convertible_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "ordered_convertible_pair_count": {
          "type": "integer",
          "minimum": 0
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "connected_components": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "unit_count",
              "unordered_convertible_pair_count",
              "ordered_convertible_pair_count",
              "units"
            ],
            "additionalProperties": false,
            "properties": {
              "unit_count": {
                "type": "integer",
                "minimum": 0
              },
              "unordered_convertible_pair_count": {
                "type": "integer",
                "minimum": 0
              },
              "ordered_convertible_pair_count": {
                "type": "integer",
                "minimum": 0
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        },
        "subcategories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/catalogGroup"
          }
        }
      }
    }
  }
}
